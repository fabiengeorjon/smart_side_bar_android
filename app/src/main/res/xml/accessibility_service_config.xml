<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal capabilities:
    - canRetrieveWindowContent=false: Edge Bar never reads on-screen content.
    - No gesture dispatch, no key filtering, no touch exploration.
    - typeWindowStateChanged is only used for the per-app hide list (package name only);
      the service sets eventTypes to 0 at runtime whenever the hide list is empty.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="200"
    android:settingsActivity="com.local.edgebar.ui.MainActivity" />

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately absent: INTERNET, SYSTEM_ALERT_WINDOW, FOREGROUND_SERVICE,
        POST_NOTIFICATIONS, QUERY_ALL_PACKAGES, CAMERA.
        CameraManager.setTorchMode needs no permission.
    -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Package visibility: launchable apps and the default calculator only. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EdgeBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.EdgeBarAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- adb-only test hook; DUMP is held by the shell and the system, not by apps. -->
        <receiver
            android:name=".service.TestControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.local.edgebar.TEST_CONFIGURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
